{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@core/*": ["./src/@core/*"],
      "@env/*": ["./src/environments/*"],
      "@spartan-ng/helm/alert": ["./src/@core/ui/ui-alert-helm/src/index.ts"],
      "@spartan-ng/helm/alert-dialog": ["./src/@core/ui/ui-alert-dialog-helm/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/@core/ui/ui-badge-helm/src/index.ts"],
      "@spartan-ng/helm/breadcrumb": ["./src/@core/ui/ui-breadcrumb-helm/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/@core/ui/ui-button-helm/src/index.ts"],
      "@spartan-ng/helm/calendar": ["./src/@core/ui/ui-calendar-helm/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/@core/ui/ui-card-helm/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/@core/ui/ui-checkbox-helm/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/@core/ui/ui-dialog-helm/src/index.ts"],
      "@spartan-ng/helm/icon": ["./src/@core/ui/ui-icon-helm/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/@core/ui/ui-input-helm/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/@core/ui/ui-label-helm/src/index.ts"],
      "@spartan-ng/helm/popover": ["./src/@core/ui/ui-popover-helm/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/@core/ui/ui-select-helm/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./src/@core/ui/ui-spinner-helm/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/@core/ui/ui-switch-helm/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/@core/ui/ui-tooltip-helm/src/index.ts"],
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
